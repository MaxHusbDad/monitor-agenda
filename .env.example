# Plantilla de configuración. Copiar a .env y completar con valores reales.
# .env NO se sube (está en .gitignore); esta plantilla sí.
#
# MONITOR_FLOWS: lista JSON de flujos a revisar. Cada flujo:
#   cat   = data-testid de la categoría
#   int   = data-testid de la intervención (Sesión 1)
#   label = etiqueta NEUTRA para la notificación (no poner info de salud; ntfy
#           no es privado). El mapeo real dejalo fuera del repo.
# En .env va entre comillas simples para sobrevivir a `source`.

MONITOR_URL=https://...
MONITOR_FLOWS='[{"cat":"20022","int":"371434","label":"Servicio 1"}]'
NTFY_TOPIC=nombre-de-topic-largo-e-impredecible
MONITOR_HEADLESS=0
